# --- Python / Django / PyInstaller ---

# Virtual Environment
backend/venv/
backend/env/
backend/.venv/
backend/ENV/

# Byte-compiled / optimized / DLL files
__pycache__/
backend/__pycache__/
electron/__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging / Eggs
*.egg-info/
.eggs/
backend/wheels/
share/python-wheels/
*.manifest

# Django stuff
*.log
local_settings.py
backend/db.sqlite3           # Development DB in backend - ignore
backend/db.sqlite3-journal # SQLite journal file

# PyInstaller #
# -------------
# Build artifacts are inside the 'backend' directory
backend/build/
backend/dist/
backend/*.spec


# --- Node.js / Electron ---

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Build output directory (Electron Forge)
electron/out/

# Dependency directories
electron/node_modules/
jspm_packages/ # If used

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history


# --- OS generated files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db


# --- IDE/Editor specific ---
.idea/           # JetBrains IDEs (PyCharm, WebStorm, etc.)
.vscode/         # VS Code (consider allowing settings/launch if shared)
# To allow sharing VS Code settings but ignore state:
# .vscode/*
# !.vscode/settings.json
# !.vscode/launch.json
# !.vscode/extensions.json
*.sublime-*


# --- Other ---
*.swp           